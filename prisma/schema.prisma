datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProductType {
  SPARE_PART
  ACCESSORY
}

enum AvailabilityStatus {
  AVAILABLE
  SOLD_OUT
}

enum Side {
  LEFT
  RIGHT
  PAIR
  UNIVERSAL
  FRONT
  REAR
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Brand {
  id       Int            @id @default(autoincrement())
  name     String
  slug     String         @unique
  models   VehicleModel[]
  products Product[]
}

model VehicleModel {
  id       Int       @id @default(autoincrement())
  brand    Brand     @relation(fields: [brandId], references: [id])
  brandId  Int
  name     String
  slug     String
  products Product[]
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  slug     String    @unique
  type     ProductType
  products Product[]
}

model Product {
  id                 Int                 @id @default(autoincrement())
  slug               String              @unique
  name               String
  description        String
  price              Decimal             @db.Decimal(10, 2)
  originalPrice      Decimal?            @db.Decimal(10, 2)
  type               ProductType
  availabilityStatus AvailabilityStatus
  offerTag           String?
  condition          String?
  image              String?
  mainYear           Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  brand      Brand        @relation(fields: [brandId], references: [id])
  brandId    Int

  model      VehicleModel @relation(fields: [modelId], references: [id])
  modelId    Int

  category   Category     @relation(fields: [categoryId], references: [id])
  categoryId Int

  fitments   ProductFitment[]
  images     ProductImage[]
  orders     Order[]
}

model ProductFitment {
  id                 Int     @id @default(autoincrement())
  product            Product @relation(fields: [productId], references: [id])
  productId          Int
  yearFrom           Int
  yearTo             Int
  side               Side
  compatibilityNotes String?
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  isPrimary Boolean @default(false)

  product   Product @relation(fields: [productId], references: [id])
  productId Int
}

model Order {
  id             Int         @id @default(autoincrement())
  customerName   String?
  customerEmail  String
  customerPhone  String
  status         OrderStatus @default(NEW)
  createdAt      DateTime    @default(now())

  product        Product     @relation(fields: [productId], references: [id])
  productId      Int
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
}
